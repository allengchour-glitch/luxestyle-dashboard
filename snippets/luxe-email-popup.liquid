{%- comment -%}
  LuxeStyle E-Mail-Capture-Popup  ·  schliesst den Signup-Leak (Capture).
  Schreibt Anmeldungen direkt nach Klaviyo (Client Subscribe API) -> Liste "Email List"
  (Double-Opt-in, DSGVO-konform) -> triggert den Welcome-Flow + zeigt WELCOME10.

  EINBAU (eine Variante):
    A) Theme-Editor -> Footer -> Block "Custom Liquid" hinzufuegen -> diesen Code einfuegen.
    B) In layout/theme.liquid vor </body>:  {% render 'luxe-email-popup' %}

  Konfig: Klaviyo Public Key + Listen-ID sind unten gesetzt. Erscheint nach 7 s ODER bei
  Exit-Intent, max. 1x pro Besucher (localStorage). Markenfarben Taupe/Cream.
{%- endcomment -%}

<div id="lx-pop" style="display:none;position:fixed;inset:0;z-index:99998;align-items:center;justify-content:center;background:rgba(44,44,44,.55);padding:16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">
  <div style="position:relative;max-width:420px;width:100%;background:#faf7f2;color:#2c2c2c;border-radius:14px;box-shadow:0 20px 60px rgba(44,44,44,.35);padding:28px 24px;text-align:center">
    <button id="lx-pop-x" aria-label="Schliessen" style="position:absolute;top:10px;right:12px;background:none;border:none;font-size:24px;line-height:1;color:#8b7355;cursor:pointer">&times;</button>
    <div id="lx-pop-form">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8b7355;margin-bottom:8px">LuxeStyle &middot; Schweiz</div>
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;line-height:1.15;margin:0 0 8px">10% auf deine erste Bestellung</h2>
      <p style="font-size:14px;color:#2c2c2ccf;margin:0 0 16px">Trag dich ein und erhalte den Code <b>WELCOME10</b> &mdash; plus exklusive Drops &amp; Angebote.</p>
      <form id="lx-pop-f" novalidate>
        <input id="lx-pop-email" type="email" required placeholder="Deine E-Mail-Adresse" autocomplete="email"
          style="width:100%;padding:13px 14px;border:1px solid #d4b896;border-radius:8px;font-size:15px;background:#fff;color:#2c2c2c;margin-bottom:10px">
        <button type="submit" id="lx-pop-go"
          style="width:100%;padding:14px;border:none;border-radius:8px;background:#2c2c2c;color:#faf7f2;font-size:15px;font-weight:600;cursor:pointer">Code sichern</button>
      </form>
      <p id="lx-pop-err" style="display:none;color:#d85a30;font-size:12px;margin:8px 0 0"></p>
      <p style="font-size:11px;color:#2c2c2c8c;margin:12px 0 0;line-height:1.45">Mit der Anmeldung stimmst du zu, E-Mails von LuxeStyle zu erhalten. Abmeldung jederzeit. Siehe <a href="/policies/privacy-policy" style="color:#8b7355">Datenschutz</a>.</p>
    </div>
    <div id="lx-pop-done" style="display:none">
      <div style="font-size:40px;line-height:1;margin-bottom:8px">&#127881;</div>
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:26px;margin:0 0 6px">Willkommen!</h2>
      <p style="font-size:14px;color:#2c2c2ccf;margin:0 0 14px">Dein 10%-Code &mdash; beim Checkout einlösen:</p>
      <div style="display:flex;gap:8px;justify-content:center;align-items:center;margin-bottom:6px">
        <span id="lx-pop-code" style="font-size:20px;font-weight:700;letter-spacing:2px;background:#fff;border:1px dashed #8b7355;border-radius:8px;padding:10px 18px">WELCOME10</span>
        <button id="lx-pop-copy" style="background:#8b7355;border:none;color:#fff;padding:11px 14px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600">Kopieren</button>
      </div>
      <p style="font-size:12px;color:#2c2c2c8c;margin:10px 0 0">Bitte bestätige noch kurz die E-Mail in deinem Postfach.</p>
    </div>
  </div>
</div>

<script>
(function(){
  var KEY="lx_popup_v1";
  var PUBLIC_KEY="XWqMAD";       // Klaviyo Public API Key (Site-ID)
  var LIST_ID="SfdmHY";          // Klaviyo "Email List" (Double-Opt-in)
  if(localStorage.getItem(KEY)) return;
  var pop=document.getElementById("lx-pop");
  if(!pop) return;
  var shown=false;
  function show(){ if(shown)return; shown=true; pop.style.display="flex"; }
  function close(){ pop.style.display="none"; if(!localStorage.getItem(KEY)) localStorage.setItem(KEY,"dismissed"); }
  function done(){ localStorage.setItem(KEY,"subscribed"); document.getElementById("lx-pop-form").style.display="none"; document.getElementById("lx-pop-done").style.display="block"; }

  setTimeout(show,7000);
  document.addEventListener("mouseout",function(e){ if(e.clientY<=0) show(); });
  document.getElementById("lx-pop-x").onclick=close;
  pop.addEventListener("click",function(e){ if(e.target===pop) close(); });

  document.getElementById("lx-pop-f").addEventListener("submit",function(e){
    e.preventDefault();
    var email=(document.getElementById("lx-pop-email").value||"").trim();
    var err=document.getElementById("lx-pop-err");
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ err.textContent="Bitte eine gültige E-Mail eingeben."; err.style.display="block"; return; }
    var btn=document.getElementById("lx-pop-go"); btn.disabled=true; btn.textContent="…";
    fetch("https://a.klaviyo.com/client/subscriptions/?company_id="+PUBLIC_KEY,{
      method:"POST",
      headers:{"Content-Type":"application/json","revision":"2024-10-15"},
      body:JSON.stringify({data:{type:"subscription",attributes:{custom_source:"Onsite Popup",profile:{data:{type:"profile",attributes:{email:email}}}},relationships:{list:{data:{type:"list",id:LIST_ID}}}}})
    }).then(function(r){
      if(r.status===202||r.ok){ done(); }
      else { err.textContent="Hat nicht geklappt — bitte später erneut."; err.style.display="block"; btn.disabled=false; btn.textContent="Code sichern"; }
    }).catch(function(){ err.textContent="Netzwerkfehler — bitte erneut."; err.style.display="block"; btn.disabled=false; btn.textContent="Code sichern"; });
  });

  document.getElementById("lx-pop-copy").onclick=function(){
    var t=document.createElement("textarea"); t.value="WELCOME10"; document.body.appendChild(t); t.select();
    try{document.execCommand("copy");}catch(e){} document.body.removeChild(t);
    this.textContent="Kopiert ✓"; var b=this; setTimeout(function(){b.textContent="Kopieren";},1500);
  };
})();
</script>
